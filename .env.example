# ---- LLM (Google Gemini, free tier via Google AI Studio) ----
GEMINI_API_KEY=your-api-key-here
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=60
GEMINI_MAX_RETRIES=3

# ---- Database ----
# Local dev (SQLite):
DATABASE_URL=sqlite:///./invoice_pipeline.db
# Production (Neon free-tier Postgres), e.g.:
# DATABASE_URL=postgresql+psycopg://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require

# ---- App ----
APP_ENV=local
AUTO_SEED_ON_BOOT=true
LOG_LEVEL=INFO
